{
  "expo": {
    "name": "unum",
    "slug": "unum",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "unum",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aaronzhxng.unum"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "12b9a43d-7541-4d8e-b709-0e9d15418ffd"
      }
    },
    "splash": {
      "image": "./assets/app_icons/game-icons_olive.png",
      "resizeMode": "contain",
      "backgroundColor": "#fafafa"
    }
  }
}
