{
  "expo": {
    "name": "Unum",
    "slug": "unum",
    "version": "1.0.2",
    "orientation": "portrait",
    "scheme": "unum",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/app_icons/app_icon_ios.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.unuminitiative.unum",
      "icon": "./assets/app_icons/app_icon_ios.png",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "allowBackup": false,
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app_icons/app_icon_android.png",
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.unuminitiative.unum",
      "googleServicesFile": "./google-services.json"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "translucent": true,
      "backgroundColor": "#fafafa"
    },
    
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app_icons/game-icons_olive.png",
          "imageWidth": 48,
          "resizeMode": "contain",
          "backgroundColor": "#fafafa",
          "dark": {
            "image": "./assets/app_icons/game-icons_olive.png",
            "backgroundColor": "#fafafa"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-system-ui",
        {
          "userInterfaceStyle": "automatic"
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/app_icons/notification_icon.png",
          "color": "#ffffff",
          "defaultChannel": "default"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "12b9a43d-7541-4d8e-b709-0e9d15418ffd"
      }
    },
    
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/12b9a43d-7541-4d8e-b709-0e9d15418ffd"
    }
  }
}
