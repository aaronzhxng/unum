{
  "expo": {
    "name": "unum",
    "slug": "unum",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "unum",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/app_icons/app_icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aaronzhxng.unum",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "allowBackup": false,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app_icons/app_icon.png",
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aaronzhxng.unum"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "translucent": true,
      "backgroundColor": "#fafafa"
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#fafafa"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app_icons/game-icons_olive.png",
          "imageWidth": 48,
          "resizeMode": "contain",
          "backgroundColor": "#fafafa",
          "dark": {
            "image": "./assets/app_icons/game-icons_olive.png",
            "backgroundColor": "#fafafa"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-system-ui",
        {
          "userInterfaceStyle": "automatic"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "12b9a43d-7541-4d8e-b709-0e9d15418ffd"
      }
    },
    "splash": {
      "image": "./assets/app_icons/game-icons_olive.png",
      "resizeMode": "contain",
      "backgroundColor": "#fafafa"
    },
    "assets": ["assets/seed.db"],
    "metro": {
      "blockList": ["scripts/.*"]
    }
  }
}
