---
import { Image } from "astro:assets";
import "@fontsource-variable/fraunces/opsz.css";
import "@fontsource-variable/fraunces/opsz-italic.css";
import "@fontsource-variable/inter";
import logo from "../assets/logo.png";
import "../styles/global.css";
import {
  CONTACT_EMAIL,
  DISCLAIMER,
  NAV_LINKS,
  NEWSLETTER_URL,
  SOCIAL_LINKS,
} from "../site.mjs";

interface Props {
  title?: string;
  description?: string;
  // On inner pages, "unum" (or "unum's") is followed by the page name
  // stacked on two small lines, e.g. "unum's" + "data &" / "sources".
  // Hovering the logo fades the page name and leaves "unum".
  brandStack?: { possessive?: boolean; lines: [string, string] };
}

const {
  title,
  brandStack,
  description = "Unum is a free, nonpartisan app for following U.S. legislation and the members of Congress who represent you.",
} = Astro.props;

const pageTitle = title ? `${title} | Unum Initiative` : "Unum Initiative";
const canonical = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname.replace(/\.html$/, "");
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/apple-touch-icon.png", Astro.site)} />
    <meta name="theme-color" content="#f4f1eb" />
  </head>
  <body>
    <header class="site-header container">
      <a href="/" class="brand" aria-label="Unum Initiative home">
        <Image src={logo} alt="" width={44} height={44} densities={[1, 2]} class="brand-icon" />
        <span class="brand-name">
          {/* Kept on one line: line breaks here would render as spaces */}
          <span class="brand-home">unum</span>{brandStack?.possessive && <span class="brand-extra">'s</span>}{brandStack && <span class="brand-extra brand-stack"><span>{brandStack.lines[0]}</span><span>{brandStack.lines[1]}</span></span>}
        </span>
      </a>
      <nav aria-label="Main">
        {
          NAV_LINKS.map((link) => (
            <a
              href={link.href}
              class:list={{ active: currentPath === link.href }}
              {...(link.external ? { target: "_blank", rel: "noopener" } : {})}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-col">
            <p class="footer-heading">Unum Initiative</p>
            <a href="/about">About</a>
            <a href="/sources">Data &amp; Sources</a>
            <a href="/support">Support &amp; FAQ</a>
            <a href={NEWSLETTER_URL} target="_blank" rel="noopener">Newsletter</a>
            <a href="/privacy">Privacy Policy</a>
          </div>
          <div class="footer-col">
            <p class="footer-heading">Follow</p>
            {
              SOCIAL_LINKS.map((link) => (
                <a href={link.href} target="_blank" rel="noopener">
                  {link.label}
                </a>
              ))
            }
          </div>
          <div class="footer-col">
            <p class="footer-heading">Contact</p>
            <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          </div>
        </div>

        <div class="footer-legal">
          <p>Unum Initiative is a 501(c)(3) nonprofit organization. {DISCLAIMER}</p>
          <p>© {year} Unum Initiative</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 40px;
    padding-bottom: 40px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    text-decoration: none;
  }

  .brand-icon {
    width: var(--logo-size);
    height: var(--logo-size);
    border-radius: 11px;
  }

  /* "unum" has only x-height letters, so dividing by Inter's x-height ratio
     (0.546) converts a letter height into a font size. The letters are set
     to 78% of the icon's height. */
  .brand {
    --logo-size: 44px;
  }

  /* With line-height 1, Inter's x-height band sits 0.091em below the middle
     of the line box, so shifting up by that much centers the letters on the
     icon — the same center line the nav links sit on. */
  .brand-name {
    font-family: var(--font);
    font-size: calc(var(--logo-size) * 0.78 / 0.546);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
    transform: translateY(-0.091em);
    /* Keep the text box no taller than the icon so the header height
       doesn't grow */
    margin-block: calc((var(--logo-size) - 1em) / 2);
    color: var(--text);
    white-space: nowrap;
  }

  .brand-name > span {
    transition:
      opacity 0.15s ease,
      color 0.15s ease;
  }

  /* The page name only fades (it keeps its space), so the hover area doesn't
     shrink under the cursor */
  .brand:hover .brand-home,
  .brand:focus-visible .brand-home {
    color: var(--blue);
  }

  .brand:hover .brand-extra,
  .brand:focus-visible .brand-extra {
    opacity: 0;
  }

  /* "unum" plus a two-line page name, sized so the two lines span the
     height of the "unum" letters: from the first line's cap height (0.727em)
     to the second line's baseline is 0.727 + 1.15 = 1.877em, and "unum" is
     Inter's x-height (0.546x the wordmark size), so the stack is
     0.546 / 1.877 = 0.291x. Its last baseline sits on the wordmark's
     baseline. */
  .brand-stack {
    display: inline-block;
    vertical-align: baseline;
    font-size: 0.291em;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-left: 0.6em;
  }

  .brand-stack > span {
    display: block;
  }

  /* The page names fit beside the nav from 480px up. On narrower phones the
     header shows just "unum", and the page's own headline names the page. */
  @media (max-width: 479px) {
    .brand-extra {
      display: none;
    }
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
  }

  nav a {
    font-size: 15px;
    font-weight: 400;
    color: var(--text-muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a.active {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .site-footer {
    margin-top: 48px;
    padding: 56px 0 40px;
    border-top: 1px solid var(--border);
    font-size: 14px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-col a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: #c8c8c8;
    overflow-wrap: anywhere;
  }

  .footer-col a:hover {
    color: var(--text);
  }

  .footer-heading {
    font-weight: 600;
    margin-bottom: 4px;
  }

  .footer-legal {
    margin-top: 48px;
    color: var(--text-faint);
    font-size: 13px;
    line-height: 1.6;
    display: grid;
    gap: 8px;
  }

  @media (max-width: 760px) {
    .site-header {
      flex-wrap: wrap;
      gap: 16px;
      padding-top: 24px;
      padding-bottom: 24px;
    }

    .brand {
      --logo-size: 30px;
      gap: 8px;
    }

    .brand-icon {
      border-radius: 7px;
    }

    nav {
      gap: 8px 18px;
    }

    nav a {
      font-size: 14px;
    }

    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
