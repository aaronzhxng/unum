---
// A short page in the newsletter signup flow (check your inbox, confirmed,
// unsubscribed), kept out of search results
import Layout from "../layouts/Layout.astro";

interface Props {
  title: string;
  heading: string;
}
const { title, heading } = Astro.props;
---

<Layout title={title} brandStack={{ lines: ["last week", "in congress"] }} newsletterNav noIndex>
  <section class="container section page-intro">
    <p class="eyebrow">Last Week in Congress</p>
    <h1>{heading}</h1>
    <div class="lede stack"><slot /></div>
    <slot name="actions" />
  </section>
</Layout>
