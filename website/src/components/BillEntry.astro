---
// One bill in a newsletter issue, in the app's visual language: the policy
// area's icon and color, the sponsor's photo, and the same stage track as the
// app's bill page. Real text rather than an image,
// so it reads well on any screen and in search results.
import { billInfo, policyArea } from "../policyAreas.mjs";
import { memberPhoto, sponsorParts } from "../members.mjs";

interface Stage {
  label: string;
  status: "done" | "current" | "todo" | "failed";
}

interface Vote {
  chamber: string;
  date: Date;
  result: string;
  yea: number;
  nay: number;
}

interface Props {
  bill: {
    id: string;
    title: string;
    policyArea?: string;
    sponsor: string;
    sponsorId?: string;
    summary: string;
    stages: Stage[];
    votes?: Vote[];
  };
}

const { bill } = Astro.props;
const { label, url } = billInfo(bill.id);
const policy = policyArea(bill.policyArea);

// The sponsor's party color rings their photo, or fills their initials when
// there is no photo
const photo = memberPhoto(bill.sponsorId);
const { initials, color } = sponsorParts(bill.sponsor);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<article class="bill" style={`--policy: ${policy.color}`}>
  <div class="bill-body">
    <h3>{bill.title}</h3>
    {/* What the bill is about and who sponsored it. Where it stands is in the
        stage track and the section heading. */}
    <div class="tags">
      {
        bill.policyArea && (
          <span class="tag area">
            <img src={`/newsletter/icons/${policy.icon}`} alt="" width="28" height="28" />
            {bill.policyArea}
          </span>
        )
      }
      <span class="tag sponsor">
        {
          photo ? (
            <img class="sponsor-photo" src={photo} alt="" width="28" height="28" loading="lazy" style={`--ring: ${color}`} />
          ) : (
            <span class="sponsor-photo initials" aria-hidden="true" style={`--ring: ${color}`}>
              {initials}
            </span>
          )
        }
        {bill.sponsor}
      </span>
    </div>
    <p class="summary">{bill.summary}</p>

    <ol class="stages" aria-label="Progress">
      {
        bill.stages.map((stage) => (
          <li class={stage.status}>
            <span>{stage.label}</span>
          </li>
        ))
      }
    </ol>

    {
      bill.votes && (
        <ul class="votes" role="list">
          {bill.votes.map((vote) => (
            <li>
              <span class="vote-where">
                {vote.chamber} · {formatDate(vote.date)}
              </span>
              <span class="vote-bar" aria-hidden="true">
                <span style={`width: ${(100 * vote.yea) / (vote.yea + vote.nay)}%`} />
              </span>
              <span class="vote-result">
                {vote.result} {vote.yea}–{vote.nay}
              </span>
            </li>
          ))}
        </ul>
      )
    }

    <a class="text-link source" href={url} target="_blank" rel="noopener">
      {label} on Congress.gov →
    </a>
  </div>
</article>

<style>
  .bill {
    padding: 32px 0;
    border-top: 1px solid var(--border);
  }

  .bill-body {
    display: grid;
    gap: 10px;
    justify-items: start;
  }

  h3 {
    font-size: 19px;
    line-height: 1.35;
  }

  /* Separate white bubbles, on two lines on phones */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 2px;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 42px;
    padding: 6px 14px 6px 7px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: #fff;
    font-size: 15px;
    line-height: 1.25;
  }

  .tag img {
    width: 28px;
    height: 28px;
    flex: none;
  }

  .area {
    color: var(--policy);
    font-weight: 500;
  }

  .sponsor {
    color: var(--text-muted);
  }

  /* Ringed in the sponsor's party color, as in the app. The ring is inside
     the 28px, so the photo lines up with the policy icon on phones. */
  .sponsor-photo {
    box-sizing: border-box;
    width: 28px;
    height: 28px;
    flex: none;
    border: 1.5px solid var(--ring, var(--border));
    border-radius: 50%;
    object-fit: cover;
  }

  .initials {
    display: grid;
    place-items: center;
    background: var(--ring);
    color: #fff;
    font-size: 11px;
    font-weight: 600;
  }

  .summary {
    color: var(--text-muted);
  }

  /* The app's stage track: one bar per stage, labels above */
  .stages {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    width: 100%;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 4px;
  }

  .stages li {
    display: grid;
    gap: 6px;
    font-size: 13px;
    line-height: 1.3;
    font-weight: 500;
  }

  .stages li::after {
    content: "";
    height: 5px;
    border-radius: 3px;
    background: #e5e2db;
  }

  .stages .done::after {
    background: var(--blue);
  }

  .stages .current::after {
    background: linear-gradient(to right, var(--blue) 50%, #e5e2db 50%);
  }

  .stages .failed {
    color: #d45252;
  }

  .stages .failed::after {
    background: #d45252;
  }

  .stages .todo {
    color: var(--text-faint);
    font-weight: 400;
  }

  .votes {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    width: 100%;
    display: grid;
    gap: 8px;
    font-size: 14px;
  }

  .votes li {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
  }

  .vote-where {
    color: var(--text-muted);
  }

  /* Yea share of the vote, against nays */
  .vote-bar {
    height: 5px;
    border-radius: 3px;
    background: #d45252;
    overflow: hidden;
  }

  .vote-bar span {
    display: block;
    height: 100%;
    background: #21954a;
  }

  .vote-result {
    font-weight: 500;
    white-space: nowrap;
  }

  .source {
    margin-top: 6px;
    font-size: 15px;
  }

  @media (max-width: 640px) {
    .bill {
      padding: 28px 0;
    }

    .tags {
      flex-direction: column;
      align-items: flex-start;
    }

    .stages li {
      font-size: 11px;
    }

    .votes li {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4px 14px;
    }

    .vote-bar {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
