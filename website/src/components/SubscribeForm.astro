---
// Email signup for Congress Weekly. Posts to /api/subscribe, which subscribes
// the address and sends a welcome email.
interface Props {
  align?: "start" | "center";
  // Keeps the input's id unique when a page has more than one form
  id?: string;
}
const { align = "start", id = align } = Astro.props;
---

<form class:list={["subscribe", align]} action="/api/subscribe" method="post" data-subscribe>
  <div class="row">
    <label class="sr-only" for={`email-${id}`}>Email address</label>
    <input
      id={`email-${id}`}
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder="you@example.com"
    />
    {/* Left empty by people; bots that fill every field are ignored */}
    <input class="trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <button type="submit">Subscribe</button>
  </div>
  {/* Cloudflare Turnstile's bot check; only shows itself if it needs a click */}
  <div class="turnstile" data-turnstile></div>
  <p class="note" role="status" data-note>Free, every Monday. Unsubscribe anytime.</p>
</form>

<style>
  .subscribe {
    width: 100%;
    max-width: 480px;
    display: grid;
    /* Lets the email field shrink below its natural width on phones */
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
  }

  .subscribe.center {
    margin-inline: auto;
    text-align: center;
  }

  .row {
    display: flex;
    gap: 8px;
  }

  input[type="email"] {
    flex: 1;
    min-width: 0;
    padding: 12px 18px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: #fff;
    font: inherit;
    font-size: 16px;
    color: var(--text);
  }

  input[type="email"]:focus {
    outline: 2px solid var(--blue);
    outline-offset: 1px;
    border-color: transparent;
  }

  .trap {
    position: absolute;
    left: -9999px;
  }

  button {
    padding: 12px 22px;
    border: none;
    border-radius: 999px;
    background: var(--blue);
    color: #fff;
    font: inherit;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  button:hover {
    transform: translateY(-1px);
  }

  button:disabled {
    opacity: 0.6;
    transform: none;
    cursor: default;
  }

  button:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 3px;
  }

  .turnstile:empty {
    display: none;
  }

  .note {
    font-size: 14px;
    color: var(--text-faint);
  }

  .note.ok {
    color: #21954a;
  }

  .note.error {
    color: #d45252;
  }
</style>

<script>
  // Turnstile's site key for the live site. Preview links (pages.dev) use
  // Cloudflare's always-pass test key, paired with its test secret there.
  const SITE_KEY =
    location.hostname === "unuminitiative.com" ? "0x4AAAAAAFz8UYR7Nvu0EMli" : "1x00000000000000000000AA";

  type Turnstile = {
    render: (el: HTMLElement, options: object) => string;
    getResponse: (id: string) => string | undefined;
    reset: (id: string) => void;
  };
  const turnstile = () => (window as unknown as { turnstile?: Turnstile }).turnstile;

  const widgets = new Map<HTMLFormElement, string>();
  const forms = [...document.querySelectorAll<HTMLFormElement>("[data-subscribe]")];

  // Loaded once for every form on the page
  const script = document.createElement("script");
  script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
  script.async = true;
  script.onload = () => {
    for (const form of forms) {
      const el = form.querySelector<HTMLElement>("[data-turnstile]")!;
      widgets.set(form, turnstile()!.render(el, { sitekey: SITE_KEY, appearance: "interaction-only" }));
    }
  };
  document.head.append(script);

  // The check usually finishes on its own within a moment of the page loading
  async function token(form: HTMLFormElement) {
    for (let i = 0; i < 50; i++) {
      const id = widgets.get(form);
      const value = id && turnstile()?.getResponse(id);
      if (value) return value;
      await new Promise((r) => setTimeout(r, 200));
    }
    return "";
  }

  for (const form of forms) {
    const note = form.querySelector<HTMLElement>("[data-note]")!;
    const button = form.querySelector("button")!;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      button.disabled = true;
      note.className = "note";
      note.textContent = "Subscribing…";
      try {
        if (!(await token(form))) throw new Error("check");
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error(String(response.status));
        const { already } = await response.json();
        form.reset();
        note.classList.add("ok");
        note.textContent = already
          ? "You are already subscribed. See you on Monday!"
          : "You are subscribed! Check your inbox for a welcome email.";
      } catch {
        note.classList.add("error");
        note.textContent = "Something went wrong. Please try again in a moment.";
      } finally {
        button.disabled = false;
        const id = widgets.get(form);
        if (id) turnstile()?.reset(id);
      }
    });
  }
</script>
