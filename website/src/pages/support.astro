---
import Layout from "../layouts/Layout.astro";
import { CONTACT_EMAIL } from "../site.mjs";

const faqs = [
  {
    q: "Is Unum free?",
    a: "Yes. Unum is completely free, with no ads and no subscriptions. We never sell your data.",
  },
  {
    q: "Is Unum affiliated with the government?",
    a: "No. Unum is built by Unum Initiative, an independent 501(c)(3) nonprofit. We are not affiliated with, endorsed by, or representing any government entity, member of Congress, the Library of Congress, or the U.S. House or Senate.",
  },
  {
    q: "Where does the information come from?",
    a: "Bills, members, and votes come from Congress.gov, the Office of the Clerk of the U.S. House, and the U.S. Senate.",
    link: { href: "/sources", label: "See all data sources" },
  },
  {
    q: "How do I find my representatives?",
    a: "Enter your zip code during setup and Unum finds your House representative and senators. Some zip codes cross district lines — if yours does, Unum shows every representative for that zip code so you can choose yours.",
  },
  {
    q: "How often is the information updated?",
    a: "Unum syncs with Congress.gov twice a day, at 8 a.m. and 4 p.m. Eastern Time. Roll-call votes appear once the House Clerk or Senate publishes them.",
  },
  {
    q: "How do notifications work?",
    a: "Notifications are opt-in. You can turn them on for specific bills and officials, for policy areas, or for a state's delegation, and change them anytime in the app.",
  },
  {
    q: "Do I need an account?",
    a: "No. Your lists and preferences are stored on your device. See our privacy policy for exactly what we store and why.",
    link: { href: "/privacy", label: "Read the privacy policy" },
  },
  {
    q: "Something in the app looks wrong. What should I do?",
    a: "Use Report an Error in the app, or email us. Include the bill or official and what looks off, and we'll look into it.",
  },
];
---

<Layout
  title="Support"
  description="Answers to common questions about the Unum app, and how to contact Unum Initiative."
>
  <section class="container narrow section intro">
    <p class="eyebrow">Support</p>
    <h1>How can we help?</h1>
    <p class="lede">
      Find answers to common questions below, or email us at
      <a class="text-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
    </p>
  </section>

  <section class="container narrow section" aria-labelledby="faq-heading">
    <h2 id="faq-heading">Frequently asked questions</h2>
    <div class="faqs">
      {
        faqs.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <div class="answer">
              <p class="muted">{item.a}</p>
              {item.link && (
                <a class="text-link" href={item.link.href}>
                  {item.link.label} →
                </a>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </section>

  <section class="container narrow section">
    <div class="card contact-card">
      <h2>Still have a question?</h2>
      <p class="muted">
        We read every message. Email
        <a class="text-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        and we'll get back to you.
      </p>
    </div>
  </section>
</Layout>

<style>
  .intro {
    padding-top: 24px;
    display: grid;
    gap: 24px;
  }

  .faqs {
    margin-top: 24px;
    border-top: 1px solid var(--border);
  }

  details {
    border-bottom: 1px solid var(--border);
  }

  summary {
    cursor: pointer;
    list-style: none;
    padding: 20px 40px 20px 0;
    font-weight: 500;
    position: relative;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: "+";
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 24px;
    font-weight: 300;
    color: var(--blue);
  }

  details[open] summary::after {
    content: "−";
  }

  .answer {
    padding: 0 0 24px;
    display: grid;
    gap: 8px;
    justify-items: start;
  }

  .contact-card {
    padding: 40px 32px;
    display: grid;
    gap: 12px;
  }
</style>
