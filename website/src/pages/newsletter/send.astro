---
// Private page for sending an issue: not linked anywhere, kept out of
// search results, and useless without the SEND_SECRET password, which
// /api/send checks. Test sends work from any link; sending to subscribers
// only works on unuminitiative.com.
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const issues = (await getCollection("newsletter")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="Send an issue" brandStack={{ lines: ["last week", "in congress"] }} noIndex>
  <section class="container section page-intro">
    <p class="eyebrow">Last Week in Congress</p>
    <h1>Send an issue</h1>
    <form class="send" data-send>
      <label>
        <span>Issue</span>
        <select name="issue">
          {issues.map((issue) => <option value={issue.id}>{issue.data.week}: {issue.data.headline}</option>)}
        </select>
      </label>
      <label>
        <span>Send password</span>
        <input type="password" name="secret" autocomplete="current-password" required />
      </label>
      <label>
        <span>Test address</span>
        <input type="email" name="to" placeholder="you@example.com" />
      </label>
      <div class="actions">
        <button type="submit" class="button" value="test">Send test</button>
        <button type="submit" class="button danger" value="all">Send to all subscribers</button>
        <a class="text-link" href="#" data-preview>Preview the email</a>
      </div>
      <p class="result" role="status" data-result></p>
    </form>
  </section>
</Layout>

<style>
  .send {
    width: 100%;
    max-width: 560px;
    display: grid;
    gap: 18px;
  }

  label {
    display: grid;
    gap: 6px;
    font-size: 15px;
    font-weight: 500;
  }

  select,
  input {
    padding: 11px 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #fff;
    font: inherit;
    font-size: 16px;
    color: var(--text);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }

  .danger {
    background: #d45252;
  }

  .result {
    font-size: 15px;
    color: var(--text-muted);
  }

  .result.ok {
    color: #21954a;
  }

  .result.error {
    color: #d45252;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-send]")!;
  const result = form.querySelector<HTMLElement>("[data-result]")!;
  const preview = form.querySelector<HTMLAnchorElement>("[data-preview]")!;
  const issue = form.querySelector<HTMLSelectElement>("select")!;

  // The email file has placeholders that /api/send fills in, so the preview
  // fills them the same way before showing it
  preview.addEventListener("click", async (event) => {
    event.preventDefault();
    const tab = window.open("", "_blank");
    const html = (await (await fetch(`/newsletter/${issue.value}/email.html`)).text())
      .replaceAll("{{origin}}", location.origin)
      .replaceAll("{{unsubscribe_url}}", `${location.origin}/newsletter/unsubscribe`)
      .replaceAll("{{mailing_address}}", "[mailing address]");
    if (tab) tab.location.href = URL.createObjectURL(new Blob([html], { type: "text/html" }));
  });

  const call = async (mode: string) => {
    const body = new FormData(form);
    body.set("mode", mode);
    const response = await fetch("/api/send", { method: "POST", body });
    const data = await response.json().catch(() => ({ error: `Error ${response.status}` }));
    if (!response.ok) throw new Error(data.error);
    return data;
  };

  const say = (text: string, tone = "") => {
    result.className = `result ${tone}`;
    result.textContent = text;
  };

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const mode = (event.submitter as HTMLButtonElement).value;
    const buttons = form.querySelectorAll("button");
    buttons.forEach((b) => (b.disabled = true));
    try {
      if (mode === "test") {
        say("Sending a test…");
        const { to } = await call("test");
        say(`Test sent to ${to}.`, "ok");
      } else {
        const { subject, subscribers, alreadySent } = await call("count");
        if (alreadySent) throw new Error(`This issue was already sent on ${alreadySent.started_at.slice(0, 10)}.`);
        if (!confirm(`Send "${subject}" to ${subscribers} subscribers? This cannot be undone.`)) return say("");
        say(`Sending to ${subscribers} subscribers…`);
        const { sent } = await call("all");
        say(`Sent to ${sent} subscribers.`, "ok");
      }
    } catch (error) {
      say((error as Error).message, "error");
    } finally {
      buttons.forEach((b) => (b.disabled = false));
    }
  });
</script>
