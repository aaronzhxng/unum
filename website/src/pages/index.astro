---
import { Image } from "astro:assets";
import StoreBadges from "../components/StoreBadges.astro";
import Layout from "../layouts/Layout.astro";
import bill1 from "../assets/screens/bill1.webp";
import bill2 from "../assets/screens/bill2.webp";
import education1 from "../assets/screens/education1.webp";
import education2 from "../assets/screens/education2.webp";
import home from "../assets/screens/home.webp";
import legislation from "../assets/screens/legislation.webp";
import official from "../assets/screens/official.webp";
import officials from "../assets/screens/officials.webp";

const values = [
  {
    title: "Nonpartisan",
    text: "We show the record — bills, votes, and actions — without editorializing.",
  },
  {
    title: "Sourced",
    text: "Every fact comes from official sources like Congress.gov and the House and Senate.",
  },
  {
    title: "Free, with no ads",
    text: "No subscriptions and no advertising, for everyone.",
  },
  {
    title: "Private",
    text: "No account required, and we never sell your data.",
  },
];

const features = [
  {
    image: home,
    title: "Your feed",
    text: "Build lists of the officials and bills you care about, and see every update in one place.",
  },
  {
    image: officials,
    title: "Every member of Congress",
    text: "Browse senators and representatives by state, and find the ones who represent you.",
  },
  {
    image: official,
    title: "Official profiles",
    text: "See each official's sponsored bills, committees, top policy areas, and contact information.",
  },
  {
    image: legislation,
    title: "Legislation",
    text: "Follow bills from the current Congress, updated twice a day and filterable by policy area.",
  },
  {
    image: bill1,
    title: "Bill details",
    text: "Track where a bill stands, from introduction to becoming law, with its sponsor and official summary.",
  },
  {
    image: bill2,
    title: "Voting records",
    text: "See how the House and Senate voted, broken down by party — and how the officials you follow voted.",
  },
  {
    image: education1,
    title: "Civics guide",
    text: "Plain-language articles on how a bill becomes law, how to read legislation, and more.",
  },
  {
    image: education2,
    title: "Learn as you read",
    text: "Key terms are explained in context, with links to official sources for more depth.",
  },
];
---

<Layout>
  <section class="hero container page-intro">
    <p class="eyebrow">Be more informed</p>
    <h1>Keep track of your elected officials and their bills.</h1>
  </section>

  <section class="container section values-section">
    <ul class="values" role="list">
      {
        values.map((value) => (
          <li>
            <h3>{value.title}</h3>
            <p class="muted">{value.text}</p>
          </li>
        ))
      }
    </ul>
    <div class="values-badges">
      <StoreBadges />
    </div>
  </section>

  <section class="container section" aria-labelledby="features-heading">
    <p class="eyebrow">The app</p>
    <h2 id="features-heading">Everything Congress is doing, in one place</h2>

    <div
      class="carousel"
      role="region"
      aria-roledescription="carousel"
      aria-label="App features"
      data-carousel
    >
      <div
        class="carousel-stage card"
        data-stage
        tabindex="0"
        aria-label="App screenshots. Use the left and right arrow keys to browse."
      >
        <div class="stage-frame">
          {
            features.map((feature, index) => (
              <div
                class:list={[
                  "stage-item",
                  index === 0
                    ? "pos-current"
                    : index === 1
                      ? "pos-next"
                      : index === features.length - 1
                        ? "pos-prev"
                        : "pos-hidden",
                ]}
                data-item
                data-title={feature.title}
                data-text={feature.text}
                aria-hidden={index === 0 ? "false" : "true"}
              >
                <Image
                  src={feature.image}
                  alt={`Unum app screen: ${feature.title}`}
                  width={560}
                  widths={[240, 360, 480, 560]}
                  sizes="(max-width: 899px) 200px, 240px"
                  loading={index < 3 ? "eager" : "lazy"}
                />
              </div>
            ))
          }
        </div>
      </div>

      <div class="carousel-copy">
        <div class="copy-box" data-copy>
          {/* Every description, stacked invisibly, reserves the height of the
              longest one so the page doesn't jump while text types out */}
          {
            features.map((feature) => (
              <p class="copy-sizer" aria-hidden="true">
                <span class="copy-title">{feature.title}</span>
                <span class="copy-text">{feature.text}</span>
              </p>
            ))
          }
          <p class="copy-typed" aria-hidden="true">
            <span class="copy-title" data-typed-title>{features[0].title}</span>
            <span class="copy-text" data-typed-text>{features[0].text}</span>
          </p>
        </div>
        <p class="sr-only" data-live aria-live="off">
          {features[0].title}: {features[0].text}
        </p>

        <div class="carousel-controls">
          <button class="carousel-button" type="button" data-prev aria-label="Previous feature">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
          </button>
          <div class="carousel-dots">
            {
              features.map((feature, index) => (
                <button
                  class="carousel-dot"
                  type="button"
                  data-dot={index}
                  aria-label={`Go to ${feature.title}`}
                  aria-current={index === 0 ? "true" : "false"}
                />
              ))
            }
          </div>
          <button class="carousel-button" type="button" data-next aria-label="Next feature">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
          </button>
          <button class="carousel-button carousel-toggle" type="button" data-toggle aria-label="Pause automatic rotation">
            <svg class="icon-pause" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
            <svg class="icon-play" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" /></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="container section cta">
    <div class="card cta-card">
      <h2>Free on iPhone and Android</h2>
      <p class="lede">Start following the bills and officials that matter to you.</p>
      <StoreBadges align="center" />
    </div>
  </section>
</Layout>

<style>
  /* Same width and left edge as the header; the text keeps a readable
     line length */
  .hero {
    padding-bottom: 24px;
  }

  .values-section {
    padding-top: 48px;
  }

  .values {
    list-style: none;
    margin: 0;
    padding: 32px 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .values-badges {
    margin-top: 32px;
  }

  .values h3 {
    margin-bottom: 8px;
  }

  .values p {
    font-size: 15px;
    line-height: 1.6;
  }

  /* Feature carousel: one screenshot at a time with its description beside
     it. The next screenshot waits, translucent, behind and to the right of
     the current one, and slides into place when the carousel advances. */
  .carousel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 64px;
    align-items: center;
  }

  .carousel-stage {
    padding: 40px 24px;
    overflow: hidden;
    touch-action: pan-y;
  }

  .carousel-stage:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 4px;
  }

  .stage-frame {
    --phone-w: 240px;
    position: relative;
    /* Screenshots are 1120 x 2282 */
    height: calc(var(--phone-w) * 2.0375);
  }

  .stage-item {
    position: absolute;
    top: 0;
    /* Center the current screenshot and the peeking next one as a group */
    left: calc((100% - var(--phone-w) * 1.4) / 2);
    width: var(--phone-w);
    transition:
      transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0.6s ease;
  }

  /* No native image dragging, which would swallow swipes */
  .stage-item img {
    width: 100%;
    height: auto;
    -webkit-user-drag: none;
    user-select: none;
  }

  .pos-current {
    transform: translateX(0) scale(1);
    opacity: 1;
    z-index: 3;
  }

  .pos-next {
    transform: translateX(46%) scale(0.84);
    opacity: 0.35;
    z-index: 2;
    cursor: pointer;
  }

  /* Parked out of sight: the previous slide to the left (so going back
     slides it in from the left), everything else to the right */
  .pos-prev {
    transform: translateX(-30%) scale(0.84);
    opacity: 0;
    z-index: 1;
  }

  .pos-hidden {
    transform: translateX(80%) scale(0.7);
    opacity: 0;
    z-index: 0;
  }

  .carousel-copy {
    min-width: 0;
  }

  .copy-box {
    display: grid;
  }

  .copy-box > p {
    grid-area: 1 / 1;
    max-width: none;
  }

  .copy-sizer {
    visibility: hidden;
  }

  .copy-title {
    display: block;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(24px, 2.6vw, 30px);
    line-height: 1.2;
    color: var(--text);
  }

  .copy-text {
    display: block;
    margin-top: 16px;
    font-size: 18px;
    line-height: 1.7;
    color: var(--text-muted);
  }

  /* Blinking cursor shown while text types out */
  .copy-box :global(.caret) {
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.1em;
    background: var(--blue);
    animation: caret-blink 0.8s steps(1) infinite;
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  .carousel-controls {
    margin-top: 40px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .carousel-button {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      transform 0.15s ease,
      background 0.15s ease;
  }

  .carousel-button:hover {
    background: #fff;
  }

  .carousel-button:active {
    transform: scale(0.94);
  }

  .carousel-button:focus-visible,
  .carousel-dot:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 2px;
  }

  .carousel-toggle {
    width: 36px;
    height: 36px;
    margin-left: 8px;
    color: var(--text-muted);
  }

  .carousel-toggle .icon-play,
  .carousel-toggle.is-paused .icon-pause {
    display: none;
  }

  .carousel-toggle.is-paused .icon-play {
    display: block;
  }

  .carousel-dots {
    display: flex;
    gap: 2px;
  }

  /* 24px tap target around an 8px dot */
  .carousel-dot {
    width: 24px;
    height: 24px;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .carousel-dot::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #cfc9bd;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .carousel-dot[aria-current="true"]::before {
    background: var(--blue);
    transform: scale(1.25);
  }

  @media (max-width: 899px) {
    .carousel {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 32px;
    }

    .stage-frame {
      --phone-w: 200px;
    }

    .carousel-controls {
      margin-top: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-item {
      transition: none;
    }

    .copy-box :global(.caret) {
      display: none;
    }
  }

  .cta-card {
    text-align: center;
    padding: 56px 24px;
    display: grid;
    gap: var(--card-heading-gap);
    justify-items: center;
  }

  @media (max-width: 860px) {
    .values {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {

    .values {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .carousel-stage {
      padding: 32px 16px;
    }

    .carousel-controls {
      gap: 8px;
    }

    .carousel-dots {
      gap: 0;
    }

    .copy-text {
      font-size: 17px;
    }
  }
</style>

<script>
  // Feature carousel. Previous/next buttons, dots, arrow keys, swipes, and a
  // click on the peeking next screenshot all navigate, wrapping at either
  // end. The description types out on each change. Auto-rotation runs while
  // the carousel is on screen and pauses on hover, focus, a hidden tab, or the
  // pause button; it's off, and text appears instantly, for visitors who
  // prefer reduced motion.
  const AUTOPLAY_MS = 7000;
  const TITLE_CHAR_MS = 32;
  const TEXT_CHAR_MS = 14;
  const POSITIONS = ["pos-current", "pos-next", "pos-prev", "pos-hidden"];

  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  for (const carousel of document.querySelectorAll<HTMLElement>("[data-carousel]")) {
    const stage = carousel.querySelector<HTMLElement>("[data-stage]")!;
    const copy = carousel.querySelector<HTMLElement>("[data-copy]")!;
    const items = [...carousel.querySelectorAll<HTMLElement>("[data-item]")];
    const dots = [...carousel.querySelectorAll<HTMLButtonElement>("[data-dot]")];
    const toggle = carousel.querySelector<HTMLButtonElement>("[data-toggle]")!;
    const typedTitle = carousel.querySelector<HTMLElement>("[data-typed-title]")!;
    const typedText = carousel.querySelector<HTMLElement>("[data-typed-text]")!;
    const live = carousel.querySelector<HTMLElement>("[data-live]")!;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const count = items.length;

    let index = 0;
    let pausedByUser = reducedMotion;
    let hovering = false;
    let focused = false;
    let inView = false;
    let seen = false;
    let timer: number | undefined;
    let typingRun = 0;

    const caret = document.createElement("span");
    caret.className = "caret";

    // Types text into an element one character at a time, with a cursor at
    // the end. Returns false if a newer run started meanwhile.
    const typeInto = async (el: HTMLElement, text: string, charMs: number, run: number) => {
      const node = document.createTextNode("");
      el.replaceChildren(node, caret);
      for (const char of text) {
        if (run !== typingRun) return false;
        node.data += char;
        await sleep(charMs);
      }
      return true;
    };

    const showCopy = async (i: number) => {
      const { title = "", text = "" } = items[i].dataset;
      live.textContent = `${title}: ${text}`;
      const run = ++typingRun;
      if (reducedMotion) {
        typedTitle.textContent = title;
        typedText.textContent = text;
        return;
      }
      typedText.textContent = "";
      if (!(await typeInto(typedTitle, title, TITLE_CHAR_MS, run))) return;
      if (!(await typeInto(typedText, text, TEXT_CHAR_MS, run))) return;
      caret.remove();
    };

    const render = () => {
      items.forEach((item, k) => {
        const offset = (k - index + count) % count;
        const position =
          offset === 0 ? "pos-current"
          : offset === 1 ? "pos-next"
          : offset === count - 1 ? "pos-prev"
          : "pos-hidden";
        item.classList.remove(...POSITIONS);
        item.classList.add(position);
        item.setAttribute("aria-hidden", offset === 0 ? "false" : "true");
      });
      dots.forEach((dot, k) =>
        dot.setAttribute("aria-current", k === index ? "true" : "false"),
      );
    };

    const goTo = (i: number) => {
      index = (i + count) % count;
      render();
      showCopy(index);
    };

    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
    };

    const sync = () => {
      const running =
        !pausedByUser && !hovering && !focused && inView && !document.hidden;
      if (running && timer === undefined) {
        timer = window.setInterval(() => goTo(index + 1), AUTOPLAY_MS);
      } else if (!running) {
        stop();
      }
      // Announce changes to screen readers only while not auto-rotating
      live.setAttribute("aria-live", running ? "off" : "polite");
    };

    // Manual navigation restarts the countdown
    const navigate = (i: number) => {
      goTo(i);
      stop();
      sync();
    };

    const renderToggle = () => {
      toggle.classList.toggle("is-paused", pausedByUser);
      toggle.setAttribute(
        "aria-label",
        pausedByUser ? "Start automatic rotation" : "Pause automatic rotation",
      );
    };

    carousel.querySelector("[data-prev]")!.addEventListener("click", () => navigate(index - 1));
    carousel.querySelector("[data-next]")!.addEventListener("click", () => navigate(index + 1));
    dots.forEach((dot, k) => dot.addEventListener("click", () => navigate(k)));
    toggle.addEventListener("click", () => {
      pausedByUser = !pausedByUser;
      renderToggle();
      sync();
    });

    // Clicking the peeking next screenshot advances to it
    items.forEach((item) =>
      item.addEventListener("click", () => {
        if (item.classList.contains("pos-next")) navigate(index + 1);
      }),
    );

    stage.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") navigate(index + 1);
      if (event.key === "ArrowLeft") navigate(index - 1);
    });

    // Horizontal swipes on the screenshots
    let swipeStartX: number | null = null;
    stage.addEventListener("dragstart", (event) => event.preventDefault());
    stage.addEventListener("pointerdown", (event) => { swipeStartX = event.clientX; });
    stage.addEventListener("pointercancel", () => { swipeStartX = null; });
    stage.addEventListener("pointerup", (event) => {
      if (swipeStartX === null) return;
      const dx = event.clientX - swipeStartX;
      swipeStartX = null;
      if (Math.abs(dx) > 40) navigate(dx < 0 ? index + 1 : index - 1);
    });

    // The screenshots and description pause rotation; the controls don't,
    // so pressing next/previous doesn't freeze it
    for (const area of [stage, copy]) {
      area.addEventListener("pointerenter", () => { hovering = true; sync(); });
      area.addEventListener("pointerleave", () => { hovering = false; sync(); });
    }
    stage.addEventListener("focusin", () => { focused = true; sync(); });
    stage.addEventListener("focusout", () => { focused = false; sync(); });
    document.addEventListener("visibilitychange", sync);

    // Start rotating, and type the first description, once it's on screen
    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        if (inView && !seen) {
          seen = true;
          showCopy(index);
        }
        sync();
      },
      { threshold: 0.4 },
    ).observe(carousel);

    renderToggle();
  }
</script>
