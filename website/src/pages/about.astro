---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import aaron from "../assets/team/aaron_zhang.png";
import gregory from "../assets/team/gregory_colonescu.jpeg";
import justin from "../assets/team/justin_liu.jpeg";
import { CONTACT_EMAIL } from "../site.mjs";

const team = [
  {
    name: "Aaron Zhang",
    role: "President and Founder",
    photo: aaron,
    linkedin: "https://www.linkedin.com/in/aaronzhxng/",
  },
  {
    name: "Gregory Colonescu",
    role: "Director of Strategy",
    photo: gregory,
    linkedin: "https://www.linkedin.com/in/gregory-colonescu/",
  },
  {
    name: "Justin Liu",
    role: "Director of Finances",
    photo: justin,
    linkedin: "https://www.linkedin.com/in/justin-j-liu/",
  },
];

const principles = [
  {
    title: "Nonpartisan",
    text: "Unum presents the legislative record as it is — bills, votes, sponsors, and actions — without commentary or endorsement. We don't tell you what to think about a bill; we make it easy to see what it does and who supports it.",
  },
  {
    title: "Independent",
    text: "Unum Initiative is a registered 501(c)(3) nonprofit. We are not affiliated with any government entity, political party, or member of Congress.",
  },
  {
    title: "Sourced",
    text: "Everything in the app comes from official, public sources, and we document exactly where.",
    link: { href: "/sources", label: "See our data sources" },
  },
  {
    title: "Free and private",
    text: "Unum is free, contains no ads, requires no account, and never sells your data. Civic information shouldn't sit behind a paywall.",
    link: { href: "/privacy", label: "Read our privacy policy" },
  },
];
---

<Layout
  brandStack={{ lines: ["about", "us"] }}
  title="About"
  description="Unum Initiative is a nonprofit civic technology organization making U.S. legislation and elected officials accessible to everyone."
>
  <section class="container section page-intro">
    <h1>Making Congress understandable for everyone</h1>
    <p class="lede">
      Unum Initiative is a civic technology organization that builds dynamic
      and user-friendly tools to bridge the accessibility gap between everyday
      Americans and the elected officials and legislation that represent their
      interests. Our goal is to demystify the U.S. lawmaking process, answer how
      your elected officials are actually working for you, and encourage civic
      engagement so that laws can more accurately work in the interest of the
      people.
    </p>
  </section>

  <section class="container section split" aria-labelledby="team-heading">
    <h2 id="team-heading">Our team</h2>
    <ul class="team" role="list">
      {
        team.map((person) => (
          <li>
            <a
              class="card member"
              href={person.linkedin}
              target="_blank"
              rel="noopener"
              aria-label={`${person.name}, ${person.role}, on LinkedIn`}
            >
              <Image
                src={person.photo}
                alt=""
                width={128}
                height={128}
                densities={[1, 2]}
                class="member-photo"
              />
              <h3>{person.name}</h3>
              <p class="muted">{person.role}</p>
              {/* Shown on hover or keyboard focus. On touch screens the first
                  tap shows it and a second tap opens LinkedIn. */}
              <span class="member-overlay" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="44" height="44" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container section split stack purpose" aria-labelledby="purpose-heading">
    <h2 id="purpose-heading">Our purpose</h2>
    <p>
      Unum’s core purpose is to display elected officials and bills in the most
      coherent way possible and translate political jargon into understandable
      and meaningful takeaways. Every page is tailored to the user experience by
      prioritizing their target policy areas and their elected officials.
    </p>
    <p>
      Unum puts the information that matters to you front and center: the bills
      being debated in your policy areas, how your representatives voted on
      legislation that affects you, and direct ways to reach them when it
      counts. Unum also provides suggested bills of the week in order to
      encourage you to keep up with current events by reading legislation for
      what it is, rather than through the lens of partisan media.
    </p>
    <p>
      Laced throughout the tool are simple, intuitive information flows that
      allow people unfamiliar with the political process to learn at their own
      pace, as well as enable politically active users to maximize their
      knowledge and achieve targeted goals.
    </p>
    <p class="purpose-closing">
      It is our ambition to push back against modern political disillusionment
      and embolden users of all backgrounds to meaningfully involve themselves
      in the civic realm, armed with an effective tool to advocate for their
      interests.
    </p>
  </section>

  <section class="container section split" aria-labelledby="principles-heading">
    <h2 id="principles-heading">What we believe</h2>
    <div class="principles">
      {
        principles.map((item) => (
          <div class="principle">
            <h3>{item.title}</h3>
            <p class="muted">{item.text}</p>
            {item.link && (
              <a class="text-link" href={item.link.href}>
                {item.link.label} →
              </a>
            )}
          </div>
        ))
      }
    </div>
  </section>


  <section class="container section split contact">
    <h2>Get in touch</h2>
    <p class="lede">
      Questions, feedback, or partnership ideas? Email us at
      <a class="text-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
    </p>
  </section>
</Layout>

<style>
  .purpose p {
    color: var(--text-muted);
  }

  .purpose .purpose-closing {
    font-family: var(--display);
    font-weight: var(--display-weight);
    font-size: 22px;
    line-height: 1.5;
    color: var(--text);
    padding-left: 20px;
    border-left: 3px solid var(--blue);
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px 48px;
  }

  .principle {
    display: grid;
    gap: 8px;
    justify-items: start;
    align-content: start;
  }

  .team {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .member {
    position: relative;
    overflow: hidden;
    height: 100%;
    padding: 32px 16px;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 4px;
    text-decoration: none;
  }

  .member-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(26, 26, 26, 0.55);
    color: #fff;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .member-overlay svg {
    transform: scale(0.9);
    transition: transform 0.2s ease;
  }

  /* Hover only where it's real, so the overlay doesn't stick after a tap */
  @media (hover: hover) {
    .member:hover .member-overlay {
      opacity: 1;
    }

    .member:hover .member-overlay svg {
      transform: scale(1);
    }
  }

  .member:focus-visible .member-overlay,
  .member.revealed .member-overlay {
    opacity: 1;
  }

  .member:focus-visible .member-overlay svg,
  .member.revealed .member-overlay svg {
    transform: scale(1);
  }

  .member:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 3px;
  }

  .member-photo {
    width: 128px;
    height: 128px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 16px;
  }

  .member h3 {
    font-size: 17px;
  }

  .member p {
    font-size: 15px;
  }

  @media (max-width: 760px) {
    .principles {
      grid-template-columns: 1fr;
    }

    .team {
      grid-template-columns: 1fr;
      max-width: 360px;
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>

<script>
  // Touch screens have no hover, so the first tap on a team card shows the
  // LinkedIn overlay and the second tap follows the link.
  const members = document.querySelectorAll<HTMLAnchorElement>(".member");

  for (const member of members) {
    member.addEventListener("click", (event) => {
      if (!matchMedia("(hover: none)").matches) return;
      if (member.classList.contains("revealed")) return;
      event.preventDefault();
      members.forEach((other) => other.classList.toggle("revealed", other === member));
    });
  }

  // Tapping anywhere else hides the overlay again
  document.addEventListener("click", (event) => {
    if ((event.target as Element).closest(".member")) return;
    members.forEach((member) => member.classList.remove("revealed"));
  });

  // Coming back from LinkedIn restores the page from cache; start fresh
  addEventListener("pageshow", () => {
    members.forEach((member) => member.classList.remove("revealed"));
  });
</script>
